# Supabase — from supabase.com dashboard → project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe — required for card payments
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# ─── Email delivery ───────────────────────────────────────────────────────────
# Transport is chosen automatically: SMTP if SMTP_HOST+SMTP_USER are set,
# otherwise Resend if RESEND_API_KEY is set. Force one with EMAIL_TRANSPORT.
# EMAIL_TRANSPORT=smtp

# Porkbun hosted email (kb.porkbun.com/article/146). Use the password you set
# for the MAILBOX, not your Porkbun account password.
#   port 587 = STARTTLS (recommended) · 465 = implicit TLS · 50587 = alt STARTTLS
SMTP_HOST=smtp.porkbun.com
SMTP_PORT=587
SMTP_USER=orders@yourdomain.com
SMTP_PASSWORD=
EMAIL_FROM=Midwestern Peptides <orders@yourdomain.com>

# Protects /api/cron/abandoned-carts. Without it the job refuses to run —
# unprotected, that endpoint is a public "email all my customers" button.
CRON_SECRET=

# Signs the /api/webhooks/stripe callback — without it no payment is ever
# marked paid. Local: run `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` and use the whsec_ it prints (that secret
# differs from the one shown for a dashboard endpoint).
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — transactional email (order confirmations, shipping updates).
# Leave empty to disable sends (they no-op with a console warning).
RESEND_API_KEY=re_...
RESEND_FROM=Midwestern Peptides <orders@midwesternpeptides.com>

# Admin dashboard — comma-separated login emails allowed into /admin.
# Leave empty in dev to allow any signed-in user; REQUIRED in production.
ADMIN_EMAILS=owner@example.com

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth email hook (branded confirm/reset mail) ─────────────────────────────
# Supabase dashboard → Authentication → Hooks → Send Email → point at
# https://yourdomain.com/api/auth/send-email and paste the generated secret here
# (it looks like `v1,whsec_...`). Without it Supabase sends its own generic
# unbranded templates.
SEND_EMAIL_HOOK_SECRET=

# ─── Admin network restriction (optional) ─────────────────────────────────────
# Comma-separated IPs, or prefixes ending in a dot ("203.0.113."). Empty = no IP
# restriction; the role check still applies either way.
ADMIN_IP_ALLOWLIST=

# ─── Error reporting (optional) ───────────────────────────────────────────────
# Leave empty to disable. Only the DSN is public-safe.
NEXT_PUBLIC_SENTRY_DSN=

# ─── Crypto payments (NOWPayments) ────────────────────────────────────────────
# No underwriting required, unlike card processing. Set a fiat or stablecoin
# payout currency in the NOWPayments dashboard so coin volatility between
# payment and conversion is not absorbed by the store.
# The IPN secret is generated in the dashboard alongside the callback URL:
# https://yourdomain.com/api/webhooks/nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
